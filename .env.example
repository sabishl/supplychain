# Safe browser configuration from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Legacy projects can use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# Optional: local UI demonstration only. Never enable in production.
# VITE_ENABLE_DEMO_MODE=true
